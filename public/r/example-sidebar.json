{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "example-sidebar",
  "title": "Sidebar example",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "@ds/sidebar"
  ],
  "files": [
    {
      "path": "registry/new-york/examples/sidebar-demo.tsx",
      "content": "import { Home, Settings, Users } from \"lucide-react\";\nimport {\n  Sidebar,\n  SidebarContent,\n  SidebarGroup,\n  SidebarGroupContent,\n  SidebarGroupLabel,\n  SidebarHeader,\n  SidebarInset,\n  SidebarMenu,\n  SidebarMenuButton,\n  SidebarMenuItem,\n  SidebarProvider,\n} from \"~/client/components/ui/sidebar\";\n\nconst items = [\n  { title: \"Início\", icon: Home },\n  { title: \"Doadores\", icon: Users },\n  { title: \"Configurações\", icon: Settings },\n];\n\nexport default function SidebarDemo() {\n  return (\n    <div className=\"h-96 overflow-hidden rounded-lg border border-border\">\n      <SidebarProvider className=\"h-full min-h-0\">\n        <Sidebar collapsible=\"none\">\n          <SidebarHeader>\n            <span className=\"px-2 text-sm font-semibold\">tektonsys-ui</span>\n          </SidebarHeader>\n          <SidebarContent>\n            <SidebarGroup>\n              <SidebarGroupLabel>Navegação</SidebarGroupLabel>\n              <SidebarGroupContent>\n                <SidebarMenu>\n                  {items.map((item) => (\n                    <SidebarMenuItem key={item.title}>\n                      <SidebarMenuButton>\n                        <item.icon />\n                        <span>{item.title}</span>\n                      </SidebarMenuButton>\n                    </SidebarMenuItem>\n                  ))}\n                </SidebarMenu>\n              </SidebarGroupContent>\n            </SidebarGroup>\n          </SidebarContent>\n        </Sidebar>\n        <SidebarInset>\n          <div className=\"flex items-center gap-2 p-4\">\n            <span className=\"text-sm text-muted-foreground\">Conteúdo principal</span>\n          </div>\n        </SidebarInset>\n      </SidebarProvider>\n    </div>\n  );\n}\n",
      "type": "registry:component"
    }
  ],
  "type": "registry:component"
}